generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            BigInt         @id @default(autoincrement()) @map("user_id")
  nama          String?
  username      String         @unique @db.VarChar(128)
  password      String         @db.VarChar(255)
  avatar        String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  references    BibReference[]
  criteria      Criteria[]
  subscriptions Subscription[]
  payments      Payment[]

  @@map("users")
}

model Plan {
  id              BigInt         @id @default(autoincrement()) @map("plan_id")
  name            String
  description     String
  price           Decimal        @default(0) @db.Decimal(10, 2)
  currency        String         @default("USD")
  billingInterval String         @default("monthly") @map("billing_interval") @db.VarChar(50)
  trialDays       Int            @default(0) @map("trial_days")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  features        PlanFeature[]
  subscriptions   Subscription[]

  @@map("plans")
}

model PlanFeature {
  id          BigInt   @id @default(autoincrement()) @map("plan_feature_id")
  planId      BigInt   @map("plan_id")
  featureKey  String   @map("feature_key")
  featureName String   @map("feature_name")
  limitValue  Int      @map("limit_value")
  limitUnit   String   @map("limit_unit")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  Plan        Plan     @relation(fields: [planId], references: [id])

  @@map("plan_features")
}

enum StatusSubscription {
  trialing
  active
  past_due
  canceled
  expired
}

model Subscription {
  id                 BigInt              @id @default(autoincrement()) @map("user_subscription_id")
  userId             BigInt              @map("user_id")
  planId             BigInt              @map("plan_id")
  status             StatusSubscription  @map("status")
  startedAt          DateTime            @map("started_at") @db.Timestamptz(6)
  trialEndsAt        DateTime            @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart DateTime            @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime            @map("current_period_end") @db.Timestamptz(6)
  cancelAt           DateTime            @map("cancel_at") @db.Timestamptz(6)
  canceledAt         DateTime            @map("canceled_at") @db.Timestamptz(6)
  endedAt            DateTime            @map("ended_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  User               User                @relation(fields: [userId], references: [id])
  Plan               Plan                @relation(fields: [planId], references: [id])
  subscriptionUsages SubscriptionUsage[]
  subscriptionEvents SubscriptionEvent[]
  payments           Payment[]

  @@index([userId])
  @@index([planId])
  @@map("user_subscriptions")
}

model SubscriptionUsage {
  id             BigInt       @id @default(autoincrement()) @map("usage_id")
  subscriptionId BigInt       @map("subscription_id")
  featureKey     String       @map("feature_key")
  usedValue      Int          @map("used_value")
  limitValue     Int          @map("limit_value")
  periodStart    DateTime     @map("period_start") @db.Timestamptz(6)
  periodEnd      DateTime     @map("period_end") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  Subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("subscription_usages")
}

model SubscriptionEvent {
  id             BigInt       @id @default(autoincrement()) @map("event_id")
  subscriptionId BigInt       @map("subscription_id")
  eventType      String       @map("event_type")
  oldValue       Json?
  newValue       Json?
  description    String       @map("description")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  Subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("subscription_events")
}

model Payment {
  id                    BigInt        @id @default(autoincrement()) @map("payment_id")
  userId                BigInt        @map("user_id")
  subscriptionId        BigInt?       @map("subscription_id")
  stripeInvoiceId       String?       @unique
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?       @unique
  amount                Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?
  failedAt              DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

model WebhookLog {
  id            BigInt    @id @default(autoincrement()) @map("webhook_log_id")
  stripeEventId String    @unique
  eventType     String
  payload       Json
  processed     Boolean   @default(false)
  processedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  @@index([eventType])
  @@index([processed])
  @@index([createdAt])
}

model TypeCriteria {
  id        BigInt     @id @default(autoincrement()) @map("type_criteria_id")
  nama      String
  deskripsi String?
  logo      String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  criteria  Criteria[]

  @@map("type_criteria")
}

model Criteria {
  id                     BigInt                   @id @default(autoincrement()) @map("criteria_id")
  nama                   String
  urutan                 Int?
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  typeCriteriaId         BigInt                   @map("type_criteria_id")
  userId                 BigInt                   @map("user_id")
  typeCriteria           TypeCriteria             @relation(fields: [typeCriteriaId], references: [id], onDelete: Cascade)
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resultCriteria         ResultCriteria[]
  resultFullTextCriteria ResultFullTextCriteria[]

  @@index([userId])
  @@index([typeCriteriaId])
  @@map("criteria")
}

model BibReference {
  id            BigInt    @id @default(autoincrement()) @map("reference_id")
  userId        BigInt    @map("user_id")
  citationKey   String    @map("citation_key")
  entryType     String    @map("entry_type") @db.VarChar(50)
  title         String?
  year          Int?      @db.SmallInt
  month         String?   @db.VarChar(20)
  journal       String?
  booktitle     String?
  publisher     String?
  institution   String?
  organization  String?
  school        String?
  volume        String?   @db.VarChar(50)
  number        String?   @db.VarChar(50)
  series        String?
  edition       String?   @db.VarChar(100)
  chapter       String?   @db.VarChar(100)
  pages         String?   @db.VarChar(100)
  address       String?
  doi           String?
  isbn          String?   @db.VarChar(50)
  issn          String?   @db.VarChar(50)
  url           String?
  urldate       DateTime? @db.Date
  note          String?
  abstract      String?
  keywords      String?
  language      String?   @db.VarChar(50)
  type          String?   @db.VarChar(100)
  howpublished  String?
  crossref      String?
  eprint        String?
  archivePrefix String?   @map("archive_prefix") @db.VarChar(100)
  primaryClass  String?   @map("primary_class") @db.VarChar(100)
  pmid          String?   @db.VarChar(50)
  pmcid         String?   @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  result        Result?

  @@index([userId])
  @@index([citationKey])
  @@index([entryType])
  @@index([year])
  @@map("bib_references")
}

model Result {
  id             BigInt           @id @default(autoincrement()) @map("result_id")
  hasil          ResultStatus
  justifikasi    String
  ai             String
  referencesId   BigInt           @unique @map("references_id")
  references     BibReference     @relation(fields: [referencesId], references: [id], onDelete: Cascade)
  resultCriteria ResultCriteria[]
  fullText       FullText[]

  @@map("results")
}

enum ResultStatus {
  Included
  Excluded
}

model ResultCriteria {
  id         BigInt   @id @default(autoincrement()) @map("result_criteria_id")
  criteriaId BigInt   @map("criteria_id")
  resultId   BigInt   @map("result_id")
  hasil      Boolean  @default(false)
  result     Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  criteria   Criteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@map("result_criteria")
}

model FullText {
  id             BigInt           @id @default(autoincrement()) @map("full_text_id")
  resultId       BigInt           @map("result_id")
  namaFile       String           @map("nama_file")
  fileMd         Bytes            @map("file_md")
  filePdf        Bytes            @map("file_pdf")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  result         Result           @relation(fields: [resultId], references: [id], onDelete: Cascade)
  resultFullText ResultFullText[]

  @@index([resultId])
  @@map("full_text")
}

model ResultFullText {
  id                     BigInt                   @id @default(autoincrement()) @map("result_full_text_id")
  fullTextId             BigInt                   @map("full_text_id")
  hasil                  ResultStatus             @default(Excluded)
  justifikasi            String                   @default("")
  ai                     String                   @default("")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  fullText               FullText                 @relation(fields: [fullTextId], references: [id], onDelete: Cascade)
  resultFullTextCriteria ResultFullTextCriteria[]

  @@index([fullTextId])
  @@map("result_full_text")
}

model ResultFullTextCriteria {
  id               BigInt         @id @default(autoincrement()) @map("result_full_text_criteria_id")
  resultFullTextId BigInt         @map("result_full_text_id")
  criteriaId       BigInt         @map("criteria_id")
  result           Boolean        @default(false)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  resultFullText   ResultFullText @relation(fields: [resultFullTextId], references: [id], onDelete: Cascade)
  criteria         Criteria       @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@index([resultFullTextId])
  @@index([criteriaId])
  @@map("result_full_text_criteria")
}
