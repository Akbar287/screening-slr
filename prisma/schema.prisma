generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         BigInt         @id @default(autoincrement()) @map("user_id")
  nama       String?
  username   String         @unique @db.VarChar(128)
  password   String         @db.VarChar(255)
  avatar     String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  references BibReference[]
  criteria   Criteria[]

  @@map("users")
}

model TypeCriteria {
  id        BigInt     @id @default(autoincrement()) @map("type_criteria_id")
  nama      String
  deskripsi String?
  logo      String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  criteria  Criteria[]

  @@map("type_criteria")
}

model Criteria {
  id                     BigInt                   @id @default(autoincrement()) @map("criteria_id")
  nama                   String
  urutan                 Int?
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  typeCriteriaId         BigInt                   @map("type_criteria_id")
  userId                 BigInt                   @map("user_id")
  typeCriteria           TypeCriteria             @relation(fields: [typeCriteriaId], references: [id], onDelete: Cascade)
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resultCriteria         ResultCriteria[]
  resultFullTextCriteria ResultFullTextCriteria[]

  @@index([userId])
  @@index([typeCriteriaId])
  @@map("criteria")
}

model BibReference {
  id            BigInt    @id @default(autoincrement()) @map("reference_id")
  userId        BigInt    @map("user_id")
  citationKey   String    @map("citation_key")
  entryType     String    @map("entry_type") @db.VarChar(50)
  title         String?
  year          Int?      @db.SmallInt
  month         String?   @db.VarChar(20)
  journal       String?
  booktitle     String?
  publisher     String?
  institution   String?
  organization  String?
  school        String?
  volume        String?   @db.VarChar(50)
  number        String?   @db.VarChar(50)
  series        String?
  edition       String?   @db.VarChar(100)
  chapter       String?   @db.VarChar(100)
  pages         String?   @db.VarChar(100)
  address       String?
  doi           String?
  isbn          String?   @db.VarChar(50)
  issn          String?   @db.VarChar(50)
  url           String?
  urldate       DateTime? @db.Date
  note          String?
  abstract      String?
  keywords      String?
  language      String?   @db.VarChar(50)
  type          String?   @db.VarChar(100)
  howpublished  String?
  crossref      String?
  eprint        String?
  archivePrefix String?   @map("archive_prefix") @db.VarChar(100)
  primaryClass  String?   @map("primary_class") @db.VarChar(100)
  pmid          String?   @db.VarChar(50)
  pmcid         String?   @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  result        Result?

  @@index([userId])
  @@index([citationKey])
  @@index([entryType])
  @@index([year])
  @@map("bib_references")
}

model Result {
  id             BigInt           @id @default(autoincrement()) @map("result_id")
  hasil          ResultStatus
  justifikasi    String
  ai             String
  referencesId   BigInt           @unique @map("references_id")
  references     BibReference     @relation(fields: [referencesId], references: [id], onDelete: Cascade)
  resultCriteria ResultCriteria[]
  fullText       FullText[]

  @@map("results")
}

enum ResultStatus {
  Included
  Excluded
}

model ResultCriteria {
  id         BigInt   @id @default(autoincrement()) @map("result_criteria_id")
  criteriaId BigInt   @map("criteria_id")
  resultId   BigInt   @map("result_id")
  hasil      Boolean  @default(false)
  result     Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  criteria   Criteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@map("result_criteria")
}

model FullText {
  id             BigInt           @id @default(autoincrement()) @map("full_text_id")
  resultId       BigInt           @map("result_id")
  namaFile       String           @map("nama_file")
  fileMd         Bytes            @map("file_md")
  filePdf        Bytes            @map("file_pdf")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  result         Result           @relation(fields: [resultId], references: [id], onDelete: Cascade)
  resultFullText ResultFullText[]

  @@index([resultId])
  @@map("full_text")
}

model ResultFullText {
  id                     BigInt                   @id @default(autoincrement()) @map("result_full_text_id")
  fullTextId             BigInt                   @map("full_text_id")
  hasil                  ResultStatus             @default(Excluded)
  justifikasi            String                   @default("")
  ai                     String                   @default("")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  fullText               FullText                 @relation(fields: [fullTextId], references: [id], onDelete: Cascade)
  resultFullTextCriteria ResultFullTextCriteria[]

  @@index([fullTextId])
  @@map("result_full_text")
}

model ResultFullTextCriteria {
  id               BigInt         @id @default(autoincrement()) @map("result_full_text_criteria_id")
  resultFullTextId BigInt         @map("result_full_text_id")
  criteriaId       BigInt         @map("criteria_id")
  result           Boolean        @default(false)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  resultFullText   ResultFullText @relation(fields: [resultFullTextId], references: [id], onDelete: Cascade)
  criteria         Criteria       @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@index([resultFullTextId])
  @@index([criteriaId])
  @@map("result_full_text_criteria")
}
